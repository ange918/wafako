# Empreinte SHA-256 du mot de passe d'accès à la console d'administration.
#
# Le code embarque une empreinte par défaut : l'application fonctionne sans
# cette variable. Définissez-la uniquement pour changer le mot de passe sans
# modifier le code.
#
# Calculer l'empreinte d'un nouveau mot de passe (en minuscules, sans espaces) :
#   node -e "console.log(require('crypto').createHash('sha256').update('MON_MOT_DE_PASSE'.trim().toLowerCase()).digest('hex'))"
#
# ATTENTION : la vérification se fait dans le navigateur et reste contournable.
# Ce garde filtre un accès de passage, il ne protège pas de données sensibles.
# Une protection réelle demanderait une vérification côté serveur.
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=
